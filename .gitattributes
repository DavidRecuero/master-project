# Line endings
# Default: Git decides per file and stores LF in the repo.
* text=auto

# Unity YAML and text assets: always LF, also in the working copy.
# Unity writes these files with LF; with core.autocrlf=true on Windows, Git converted them
# to CRLF and every save showed them as modified with no real change.
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable text eol=lf
*.mask text eol=lf
*.brush text eol=lf
*.flare text eol=lf
*.fontsettings text eol=lf
*.guiskin text eol=lf
*.giparams text eol=lf
*.renderTexture text eol=lf
*.spriteatlas text eol=lf
*.spriteatlasv2 text eol=lf
*.terrainlayer text eol=lf
*.mixer text eol=lf
*.shadervariants text eol=lf
*.preset text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.tss text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

