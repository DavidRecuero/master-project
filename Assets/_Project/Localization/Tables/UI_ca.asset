    m_Metadata:
      m_Items: []
  - m_Id: 348100000000005
    m_Localized: "S'est\xE0 esborrant el compte..."
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000006
    m_Localized: "Necessites connexi\xF3 a internet per esborrar el compte. Esperant connexi\xF3..."
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000007
