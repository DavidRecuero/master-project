  - m_Id: 347740696379392
    m_Localized: Privacy policy
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000001
    m_Localized: Delete account
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000002
    m_Localized: DELETE ACCOUNT
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000003
    m_Localized: "Your progress, coins and boosters will be deleted from this device and from our servers. This can't be undone."
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000004
    m_Localized: HOLD TO DELETE
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000005
    m_Localized: Deleting your account...
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000006
    m_Localized: You need an internet connection to delete your account. Waiting for connection...
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000007
    m_Localized: "Your account couldn't be deleted. Please try again."
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000008
    m_Localized: Connecting...
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000009
    m_Localized: Your account has been deleted. The game will now close.
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000010
    m_Localized: Abandon level
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000011
    m_Localized: "ABANDON LEVEL?"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000012
    m_Localized: "If you leave now, you will lose this level and a life. Boosters you have already used won't be given back."
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000013
    m_Localized: ABANDON
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000014
    m_Localized: KEEP PLAYING
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000015
    m_Localized: "LIVES"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000016
    m_Localized: "Full"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000017
    m_Localized: "You have all your lives!"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000018
    m_Localized: "Next life in {time}"
    m_Metadata:
      m_Items:
      - rid: 3524684200313618700
  - m_Id: 348100000000019
    m_Localized: "REFILL FOR {price}"
    m_Metadata:
      m_Items:
      - rid: 3524684200313618700
  - m_Id: 348100000000020
    m_Localized: "Not enough coins."
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000021
    m_Localized: "You have a life again!"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000022
    m_Localized: "OUT OF LIVES"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000023
    m_Localized: "Wait for your next life or buy one to keep playing."
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000024
    m_Localized: "1 LIFE FOR {price}"
    m_Metadata:
      m_Items:
      - rid: 3524684200313618700
  - m_Id: 348100000000025
    m_Localized: "YOUR PRIVACY"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000026
    m_Localized: "With your permission, we use analytics to see how the game is played, improve the levels and find errors. This sends gameplay and device data (never your name or email) to our analytics provider. You can change your choice at any time in Settings."
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000027
    m_Localized: "ACCEPT"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000028
    m_Localized: "REJECT"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000029
    m_Localized: "Privacy"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000030
    m_Localized: "PRIVACY"
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000031
    m_Localized: "We use analytics to see how the game is played, improve the levels and find errors. You can turn them on or off at any time."
    m_Metadata:
      m_Items: []
  - m_Id: 348100000000032
    m_Localized: "Analytics"
    m_Metadata:
      m_Items: []
