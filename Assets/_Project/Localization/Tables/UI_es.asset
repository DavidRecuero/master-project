  - m_Id: 102293733377
    m_Localized: "CR\xC9DITOS"
    m_Metadata:
      m_Items: []
  - m_Id: 102293733378
    m_Localized: "\xA1NIVEL SUPERADO!"
    m_Metadata:
      m_Items: []
  - m_Id: 102293733379
    m_Localized: "Todas las tuber\xEDas est\xE1n vac\xEDas. \xA1Buen trabajo!"
    m_Metadata:
      m_Items: []
  - m_Id: 102293733380
    m_Localized: SIGUIENTE NIVEL
    m_Metadata:
      m_Items: []
  - m_Id: 102293733381
    m_Localized: "\xA1SIN ESPACIO!"
    m_Metadata:
      m_Items: []
  - m_Id: 102293733382
    m_Localized: "La bandeja est\xE1 llena"
    m_Metadata:
      m_Items: []
  - m_Id: 102293733383
    m_Localized: REINTENTAR
    m_Metadata:
      m_Items: []
  - m_Id: 102293733384
